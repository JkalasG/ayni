# Variant for a server that already has nginx (or Apache) on ports 80/443: Caddy only speaks plain HTTP inside the
# machine, on the port docker-compose.nginx.yml publishes on 127.0.0.1. nginx terminates HTTPS and forwards here.
{
	auto_https off
}

:80 {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle {
		root * /srv
		@static path /_expo/static/* /assets/* /bryntum/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
