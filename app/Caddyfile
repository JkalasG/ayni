# {$DOMAIN} comes from the environment (docker-compose.yml). With a real host name Caddy gets and renews the HTTPS
# certificate by itself; ports 80 and 443 must be open.
{$DOMAIN} {
	encode zstd gzip

	# The API lives under /api: the prefix is removed before it reaches the Node server
	handle_path /api/* {
		reverse_proxy api:4000
	}

	# The web app (single-page): any other path answers with index.html
	handle {
		root * /srv
		@static path /_expo/static/* /assets/* /bryntum/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
