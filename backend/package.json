{
  "name": "ayni-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Ayni backend: rotating savings groups (pasanaku) on PayPal + Claude",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/boot.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/boot.js",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e": "tsx test/e2e.ts",
    "mock:reset": "tsx src/mock/reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@prisma/client": "^6.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "embedded-postgres": "^17.5.0-beta.15",
    "prisma": "^6.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
