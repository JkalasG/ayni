// Ayni data model. Money is always stored in integer cents (USD).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum OrderMethod {
  LOTTERY // sorteo tradicional
  AI // la IA propone, el grupo vota
  ORGANIZER // lo decide el organizador
}

enum GroupStatus {
  FORMING // aceptando miembros
  ORDERING // definiendo el orden de turnos
  ACTIVE // rondas en curso
  FINISHED
  CANCELLED // el organizador lo canceló antes de empezar: depósitos devueltos
}

enum RoundStatus {
  UPCOMING
  COLLECTING // esperando aportes
  READY // todos pagaron (o se cubrió con retención): pozo listo
  PAID_OUT
}

enum ContributionStatus {
  PENDING
  PAID
  COVERED // cubierto con la retención del miembro
  DEFAULTED // no pagó y su garantía no alcanzó: el grupo lo absorbió (cuenta como abandono)
}

enum AdmissionMode {
  MANUAL // el organizador decide cada solicitud
  AUTO // se acepta si cumple las reglas, se rechaza si no
  AI // automático si cumple; en casos límite la IA recomienda y el organizador decide
}

enum JoinRequestStatus {
  AWAITING_DEPOSIT // falta autorizar el depósito en PayPal
  PENDING // esperando decisión
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PayoutKind {
  POT // pozo de la ronda
  RETENTION_RELEASE // devolución de la retención al final
  COMPENSATION // deuda de quien no pagó, descontada de su pozo y pagada a quien recibió de menos
}

enum PayoutStatus {
  PENDING
  SENT
  SUCCEEDED
  FAILED // PayPal answered with an error: safe to send again as a NEW payout
  UNKNOWN // timeout / network / 5xx: PayPal may have it. Retry ONLY with the same sender_batch_id
}

enum ActionType {
  RELEASE_POT
  APPLY_LATE_FEE
  SWAP_TURNS
  APPROVE_ORDER
  ADMIT_MEMBER // solicitud de un pasanaku abierto
  WAIVE_CONTRIBUTION // aporte impago sin garantía suficiente: liberar el pozo sin él
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_EXECUTED
  EXECUTED
}

model User {
  id             String        @id @default(cuid())
  paypalUserId   String        @unique
  // PayPal account id (payer_id) from Log in with PayPal. Payouts go to it when we have it:
  // it always points to the account that logged in, even if the person changes their email.
  paypalPayerId  String?
  email          String // PayPal email: where payouts are sent when there is no payer id
  // PayPal vault token: a payment method the member chose to save, used for automatic contributions.
  paypalVaultId  String?
  // Read-only keys for the member's own AI assistant (MCP) carry this number; raising it revokes them all.
  mcpEpoch       Int           @default(0)
  name           String
  locale         String        @default("es")
  country        String? // ISO 3166-1 alpha-2, where the person lives (pasanakus across countries)
  paypalVerified Boolean       @default(false) // logged in with a real PayPal account
  pushToken      String? // Expo push token (Android)
  createdAt      DateTime      @default(now())
  memberships    Membership[]
  organized      Group[]       @relation("organizer")
  joinRequests   JoinRequest[]
}

model Group {
  id                   String          @id @default(cuid())
  name                 String
  inviteCode           String          @unique
  organizerId          String
  organizer            User            @relation("organizer", fields: [organizerId], references: [id])
  contributionCents    Int
  currency             String          @default("USD")
  country              String          @default("BO") // ISO 3166-1 alpha-2, where the group is based
  frequency            Frequency
  orderMethod          OrderMethod
  maxMembers           Int             @default(10)
  lateFeePct           Int             @default(5) // % of the contribution
  maxRetentionPct      Int             @default(25) // retention for turn #1, tapering to 0
  graceHours           Int             @default(48)
  approvalTimeoutHours Int             @default(24) // organizer silence => auto-execute
  status               GroupStatus     @default(FORMING)
  // Demo mode: rounds last minutes instead of weeks so a full cycle fits in a video.
  demoMode             Boolean         @default(false)
  demoRoundMinutes     Int             @default(3)
  startsAt             DateTime?
  // Open pasanakus: strangers can ask to join, filtered by their trust profile.
  isOpen               Boolean         @default(false)
  description          String?
  admissionMode        AdmissionMode   @default(AI)
  minCompleted         Int             @default(0)
  minOnTimePct         Int             @default(0)
  maxLate              Int? // null = no limit
  acceptNewcomers      Boolean         @default(true)
  newcomerExtraPct     Int             @default(10) // extra guarantee for newcomers
  requireDeposit       Boolean         @default(true) // authorize one contribution when requesting
  createdAt            DateTime        @default(now())
  memberships          Membership[]
  rounds               Round[]
  actions              PendingAction[]
  messages             ChatMessage[]
  joinRequests         JoinRequest[]
  aiLogs               AiLog[]
}

model Membership {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  groupId            String
  group              Group          @relation(fields: [groupId], references: [id])
  turn               Int? // 1-based; null until order is set
  retentionPct       Int            @default(0)
  retentionHeldCents Int            @default(0) // currently withheld from their pot
  riskScore          Int            @default(50) // 0 = safest, 100 = riskiest
  riskReason         String? // AI explanation, shown to the group
  isNewcomer         Boolean        @default(false) // admitted to an open group with no Ayni history
  depositCaptureId   String? // admission deposit, used as their round-1 contribution
  chatReadAt         DateTime? // last time they opened the group chat (unread counter)
  autoPay            Boolean        @default(false) // charge each round with the member's saved PayPal method
  joinedAt           DateTime       @default(now())
  contributions      Contribution[]
  payouts            Payout[]
  received           Round[]        @relation("recipient")

  @@unique([userId, groupId])
}

model Round {
  id            String         @id @default(cuid())
  groupId       String
  group         Group          @relation(fields: [groupId], references: [id])
  number        Int
  recipientId   String
  recipient     Membership     @relation("recipient", fields: [recipientId], references: [id])
  dueAt         DateTime
  status        RoundStatus    @default(UPCOMING)
  contributions Contribution[]
  payouts       Payout[]

  @@unique([groupId, number])
}

model Contribution {
  id               String             @id @default(cuid())
  roundId          String
  round            Round              @relation(fields: [roundId], references: [id])
  membershipId     String
  membership       Membership         @relation(fields: [membershipId], references: [id])
  amountCents      Int
  lateFeeCents     Int                @default(0)
  status           ContributionStatus @default(PENDING)
  paypalOrderId    String?            @unique
  paypalCaptureId  String?
  paypalFeeCents   Int? // PayPal's fee on this capture, as PayPal reported it (null = not reported)
  paypalNetCents   Int? // what reached the platform account after the fee
  paypalInvoiceId  String?            @unique // PayPal invoice sent at the "firm" stage
  recoveredCents   Int                @default(0) // DEFAULTED: part recovered from their guarantee
  compensatedCents Int                @default(0) // DEFAULTED: part later taken from their own pot
  paidAt           DateTime?
  remindersSent    Int                @default(0)
  lastReminderAt   DateTime?
  saveMethod         Boolean   @default(false) // the member asked PayPal to save their method in this checkout
  autoPayNoticeAt    DateTime? // when they were told the automatic charge is coming
  autoPayAttemptedAt DateTime? // one automatic attempt per contribution

  @@unique([roundId, membershipId])
}

model Payout {
  id            String       @id @default(cuid())
  roundId       String?
  round         Round?       @relation(fields: [roundId], references: [id])
  membershipId  String
  membership    Membership   @relation(fields: [membershipId], references: [id])
  kind          PayoutKind
  amountCents   Int
  status        PayoutStatus @default(PENDING)
  paypalBatchId String?
  paypalItemId  String?
  retriedById   String? // FAILED payout that the organizer re-sent as a new payout
  createdAt     DateTime     @default(now())
}

model PendingAction {
  id         String       @id @default(cuid())
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id])
  type       ActionType
  payload    Json
  summary    String // human-readable, shown to the organizer
  status     ActionStatus @default(PENDING)
  createdBy  String // "system" | "ai" | userId
  expiresAt  DateTime // after this, auto-execute
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
}

model ChatMessage {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  userId    String? // null => assistant / system
  role      String // "user" | "assistant" | "system"
  kind      String   @default("text") // "text" | "event" (something that happened, e.g. PayPal confirmed a payment)
  event     Json? // event data the app renders in the reader's language: { type, round?, name?, amountCents?, heldCents? }
  content   String
  // Questions to the assistant and its answers talk about one person's money: only that member sees them.
  visibleToUserId String?
  // Taken back by its author or moderated by the organizer: the row stays, the text is no longer shown.
  hiddenAt   DateTime?
  hiddenById String?
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  groupId   String?
  kind      String // "reminder" | "pot" | "action" | "mediation"
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model JoinRequest {
  id               String            @id @default(cuid())
  groupId          String
  group            Group             @relation(fields: [groupId], references: [id])
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  status           JoinRequestStatus @default(PENDING)
  message          String?
  profile          Json // trust profile snapshot at request time
  failures         Json // admission rules not met
  meetsRules       Boolean
  borderline       Boolean           @default(false)
  aiRecommendation String? // "accept" | "reject"
  aiReason         String?
  depositCents     Int               @default(0)
  paypalOrderId    String?           @unique
  authorizationId  String?
  createdAt        DateTime          @default(now())
  resolvedAt       DateTime?

  @@index([groupId, status])
}

/**
 * What the AI looked at and why it decided. Visible to the group (transparency).
 */
model AiLog {
  id            String   @id @default(cuid())
  groupId       String?
  group         Group?   @relation(fields: [groupId], references: [id])
  kind          String // "chat" | "reminder" | "order" | "guarantee" | "admission" | "disputes"
  source        String // "claude" | "fallback" | "rules"
  subject       String // one line: what was decided
  consulted     Json // tools / data the AI looked at
  output        String // the decision and its explanation
  // "group": every member sees it · "organizer": only the organizer and the person it is about
  audience      String   @default("group")
  subjectUserId String?
  createdAt     DateTime @default(now())

  @@index([groupId, createdAt])
}

enum ClaimStatus {
  OPEN // reported by the member, waiting for the organizer
  REFUNDING // the organizer accepted; PayPal is giving the money back
  REFUNDED
  REJECTED // the organizer explained; the member can still open a PayPal dispute
  ESCALATED // a PayPal dispute is open: PayPal decides, Ayni no longer refunds this contribution
  RESOLVED // PayPal decided
}

/**
 * A member's report about one of their own contributions, linked to a PayPal dispute through the capture id.
 */
model Claim {
  id             String      @id @default(cuid())
  groupId        String
  contributionId String
  membershipId   String
  userId         String
  kind           String // DOUBLE_CHARGE | WRONG_AMOUNT | NOT_RECOGNIZED | OTHER | PAYPAL_DISPUTE
  message        String?
  captureId      String // the PayPal capture the claim is about: how a dispute finds it
  status         ClaimStatus @default(OPEN)
  paypalDisputeId String?
  outcome        String?
  note           String? // the organizer's answer, or PayPal's decision in words
  timeline       Json        @default("[]")
  createdAt      DateTime    @default(now())
  resolvedAt     DateTime?

  @@index([groupId, status])
  @@index([contributionId])
  @@index([paypalDisputeId])
}

enum RefundStatus {
  PENDING // recorded; PayPal's answer is not known yet (retried with the same idempotency key)
  COMPLETED
  FAILED // PayPal said no: the organizer can retry
}

/**
 * Money that went back to a member through PayPal Refunds.
 */
model Refund {
  id             String       @id @default(cuid())
  groupId        String
  userId         String
  membershipId   String?
  contributionId String?
  captureId      String // the PayPal capture that was refunded
  amountCents    Int
  // GROUP_CANCELLED: we refunded a deposit · PAYPAL_REFUND / PAYPAL_REVERSAL: PayPal did it (manual refund, dispute)
  reason         String
  status         RefundStatus @default(PENDING)
  paypalRefundId String?      @unique
  dedupeKey      String?      @unique // one refund of ours per capture
  attempts       Int          @default(0) // part of the idempotency key: changes only after a definite failure
  reopened       Boolean      @default(false) // the contribution went back to "pending" (it no longer counts as paid)
  createdAt      DateTime     @default(now())

  @@index([groupId])
}

/**
 * PayPal webhook events already handled: a repeated delivery is ignored.
 */
model WebhookEvent {
  id         String   @id // PayPal event id
  type       String
  receivedAt DateTime @default(now())
}
