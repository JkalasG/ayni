# --- Server ---
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of this backend. PayPal redirects here, so in local dev use a tunnel (ngrok/cloudflared) or deploy to Render.
PUBLIC_API_URL=http://localhost:4000
# Web build of the app (Expo web)
APP_WEB_URL=http://localhost:8081
APP_SCHEME=ayni
# Show "log in as demo member" for judges (seeded sandbox users)
ENABLE_DEMO_LOGIN=true

# --- Database (Render Postgres, Neon, or local) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ayni

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEB_BASE=https://www.sandbox.paypal.com
# Webhook ID from the dashboard (Webhooks section of your app)
PAYPAL_WEBHOOK_ID=

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Emails of 5 sandbox PERSONAL accounts, used by `npm run db:seed`
DEMO_MEMBER_EMAILS=
