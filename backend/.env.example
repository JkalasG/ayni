# --- Mode ---
# live: real PayPal sandbox + Claude + DATABASE_URL (everything below is needed)
# mock: NOTHING external. Local embedded database, simulated PayPal, assistant without AI,
#       and sample data. Just `npm run dev`. To start over: `npm run mock:reset`.
APP_MODE=live

# --- Server ---
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of this backend. PayPal redirects here, so in local dev use a tunnel (ngrok/cloudflared) or deploy to Render.
PUBLIC_API_URL=http://localhost:4000
# Web build of the app (Expo web)
APP_WEB_URL=http://localhost:8081
APP_SCHEME=ayni
# Show "log in as demo member" for judges (seeded sandbox users)
ENABLE_DEMO_LOGIN=true

# --- Database ---
# Use Neon (free, never expires) for the hosted demo: Render's free Postgres expires after 30 days.
# e.g. postgresql://user:pass@ep-xxx.neon.tech/ayni?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ayni
# Engine tick (ms): reminders, late fees, invoices, guarantee coverage, auto-execution
ENGINE_INTERVAL_MS=20000

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEB_BASE=https://www.sandbox.paypal.com
# Webhook ID from the dashboard (Webhooks section of your app)
PAYPAL_WEBHOOK_ID=

# --- The assistant's model: choose ONE of the two ways (with neither, the app uses fixed rules) ---
# 1) Claude (paid, per use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 2) Any OpenAI-compatible service. If AI_BASE_URL and AI_MODEL are set, this one is used.
#    Google Gemini (free tier):  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#    Groq (free tier):           AI_BASE_URL=https://api.groq.com/openai/v1
#    Ollama on this machine:     AI_BASE_URL=http://localhost:11434/v1   (no key needed)
#    AI_MODEL is the model name exactly as that service lists it; it must support tool / function calling.
#    Several names separated by commas are tried in order when one is busy: AI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Emails of 7 sandbox PERSONAL accounts, used by `npm run db:seed`, in this order:
# Doña Rosa, Juan Carlos, Marisol, Don Efraín, Wara, Tomás, Kusi
DEMO_MEMBER_EMAILS=

# Only for `npm run test:e2e`: an EMPTY throwaway database (the test writes data)
E2E_DATABASE_URL=
