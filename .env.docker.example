# Copy to `.env` next to docker-compose.yml and fill it in. `.env` is never committed.

# --- Where it will be reached ---
# A host name that points to this server (an A record). No "https://", no slash.
# No domain yet? Use your server's IP with sslip.io, e.g. 203-0-113-10.sslip.io (it works with HTTPS too).
DOMAIN=ayni.example.com

# --- Secrets you invent ---
# Letters and digits only (it goes inside a database URL):  openssl rand -hex 24
POSTGRES_PASSWORD=
# A long random string:  openssl rand -hex 48
JWT_SECRET=

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook that points to https://DOMAIN/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# --- The assistant's model: ONE of the two (with neither, the app uses its fixed rules) ---
# 1) Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 2) Any OpenAI-compatible service (if AI_BASE_URL and AI_MODEL are set, this one is used)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Demo for the judges ---
ENABLE_DEMO_LOGIN=true
# 7 sandbox PERSONAL accounts, in this order: Doña Rosa, Juan Carlos, Marisol, Don Efraín, Wara, Tomás, Kusi
DEMO_MEMBER_EMAILS=
# The password those accounts share (shown on the welcome screen while ENABLE_DEMO_LOGIN=true)
DEMO_MEMBER_PASSWORD=

# --- Web build ---
# Bryntum license key (optional: without it the trial badge shows). Changing it needs `docker compose build web`.
EXPO_PUBLIC_BRYNTUM_LICENSE=
